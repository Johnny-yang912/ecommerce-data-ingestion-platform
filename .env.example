# 環境變數範本 — 複製成 .env 後填入真值（.env 不進版控）
# 由 config.py 的 Settings 載入；未列在此的鍵會被忽略（extra="ignore"）。

# === 必填 ===
# PostgreSQL 連線字串；缺此值服務啟動時即報錯（fail-fast）
DB_URL=postgresql://user:password@localhost:5432/dbname

# 服務對服務認證：格式 key:client_id，逗號分隔多組（同 client 可多把 key 做輪替）
API_KEYS=your_key:upstream-order-api

# === 選填（以下為預設值，需要時才覆寫）===
# DB connection pool 與 statement timeout
# POOL_SIZE=5
# MAX_OVERFLOW=10
# POOL_TIMEOUT=30
# STATEMENT_TIMEOUT_MS=30000

# 背景 stuck-record 掃描間隔（秒）
# SCAN_INTERVAL_SECONDS=300

# 日誌格式：console（開發，人類可讀）| json（生產，結構化）
# LOG_FORMAT=console

# === Phase 4：分析管線（ODS → BigQuery）===
# BigQuery service-account 金鑰路徑（與 dbt 共用同一把）。
# 僅抽取腳本用得到；API server 不需要，留空亦可正常啟動。
# 正式環境（Airflow / Cloud Run）改由平台注入此環境變數，會優先於此值（見 bq.py 的 setdefault）。
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/keydir/service-account-key.json
#
# Airflow overlay 另外需要下面這條，指向【同一把金鑰】。它只給 compose 當單檔 bind
# 的來源，唯讀掛到容器內的固定路徑 /opt/secrets/sa-key.json；overlay 的 environment
# 會把容器內的 GOOGLE_APPLICATION_CREDENTIALS 指向該固定路徑。
# ⚠️ 為什麼不直接重用 GOOGLE_APPLICATION_CREDENTIALS 當 bind 來源：那是 Google SDK
#    的標準名，屬於公共命名空間，任何 shell／工具都可能已經 export 它；而 compose 的
#    ${...} 替換是【shell 環境優先於 .env】。一旦兩邊不一致，掛載來源會被靜默換掉，
#    compose 不會有任何提示，而 .env 看起來完全正常。分開命名是為了讓掛載來源只有
#    一個權威處。
# ⚠️ 請寫完整字面值，不要用 ${...} 合成——config.py 的 pydantic-settings 讀 .env
#    不做變數內插，會原樣拿到含 ${} 的字串。
# GCP_SA_KEY_PATH=/path/to/service-account-key.json

# BigQuery 目的地專案 ID（注意是 project ID，非顯示名稱；GCP 常自動補數字後綴）。
# 僅抽取腳本用得到；缺值時腳本啟動即報錯（fail-fast），API server 不受影響。
# BQ_PROJECT=your-gcp-project-id

# === Phase 5：Proposal B 重評估（讀 dbt 產出的 int_ 層）===
# dbt profile 的 target dataset。dev/prod 不同專案或不同 dataset 時才需覆寫。
# 僅 reevaluate_quality.py 用得到。
# BQ_DBT_DATASET=dbt_dev

# === Phase 5：Celery + Redis 任務佇列（取代 BackgroundTasks）===
# 攝入路徑的 broker。不設會用 redis://localhost:6379/0（本機直跑 uvicorn + worker 的情境）；
# docker compose 下由 compose 注入 redis://redis:6379/0 覆蓋。
# 【重要】這台 Redis 專屬攝入路徑，**不要**與 Airflow 共用實例——兩者時間尺度與失敗語意
# 都不同（見 ORCHESTRATION-TW〈範圍與職責邊界〉），共用會讓故障域糾纏。
# 目前 Airflow 用 LocalExecutor、沒有 broker，但這條約束要先寫下來，
# 以免未來換 CeleryExecutor 時順手接到同一台。
# CELERY_BROKER_URL=redis://localhost:6379/0

# 限流計數器的儲存位置。不設 = 行程記憶體（本機單行程開發、pytest 都夠用）。
# 【多行程部署必設】slowapi 預設把計數器放在行程記憶體，跑 N 個 uvicorn worker
# 時 60/minute 會實質變成 60×N。docker compose 下由 compose 注入 db 1。
# 與 broker 共用實例但分開 DB index（broker=0 / 限流=1）。
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379/1

# docker compose 下 api 要開幾個 uvicorn worker（預設 4）。
# 能開多行程的前提是恢復掃描已搬到 Celery Beat、API 行程不再持有背景狀態。
# UVICORN_WORKERS=4

# === Phase 5：Airflow（僅跑 docker-compose.airflow.yml 時用到）===
# 容器以此 uid 執行。不設會用 50000，容器寫進 bind mount 的 dbt target/ 與 logs/
# 主機端會清不掉。建議：AIRFLOW_UID=$(id -u)
# AIRFLOW_UID=1000

# Airflow 各元件之間互相呼叫用的 JWT 密鑰（api-server / scheduler / dag-processor
# 必須一致）。本機練習用預設值即可，正式環境務必換掉。
# AIRFLOW_JWT_SECRET=local-dev-only-change-me

# 注意：BQ_PROJECT、GCP_SA_KEY_PATH 在 Airflow overlay 下是【必填】——BQ_PROJECT 被
# dbt profile 與抽取腳本共用；GCP_SA_KEY_PATH 是金鑰單檔唯讀掛進容器的來源，缺值時
# compose 會在解析階段直接報錯（volumes 帶了 ${...:?} 守衛），不會靜默掛出空東西。
# 主機端直接跑抽取腳本或 dbt 時走的仍是 GOOGLE_APPLICATION_CREDENTIALS，
# 兩者要指向同一把金鑰。

# seed_demo.py 送單的目標。Airflow overlay 下預設 http://api:8000/orders
# （同一個 compose project 的 api 服務）。
# ⚠️ 它與 Airflow task 的 DB_URL 必須指向【同一套系統】。灌進 A 庫、抽 B 庫的話，
#    DAG 會全綠、ODS 零增長、freshness 照樣紅，而且沒有任何錯誤訊息。
# SEED_API_URL=http://api:8000/orders

# === Phase 5：OpenTelemetry（Grafana Cloud）===
# 憑證只有 otel-collector 服務會讀。應用程式（api / worker / beat）一律送到
# 本機 Collector，不直連雲端——這是「憑證只存在一處」的前提。
#
# ⚠️ 這兩個名字是【刻意改過的】。Grafana 產生的原始片段用的是 OTel 規格標準名
#    OTEL_EXPORTER_OTLP_ENDPOINT / OTEL_EXPORTER_OTLP_HEADERS，而任何 OTel SDK
#    一看到那兩個名字就會【直接往雲端送】，靜默繞過 Collector：沒有錯誤訊息、
#    資料照樣進得去 Grafana，只是 Collector 根本不在路徑上，憑證也散到每個服務。
#    標準名在本專案保留給「app → Collector」這個語意（見 docker-compose.yml）。
#    同一條教訓見上方 GCP_SA_KEY_PATH / GOOGLE_APPLICATION_CREDENTIALS 的分工。
#
# 取得方式：Grafana Cloud Portal → 你的 stack → OpenTelemetry 設定卡片 → 產生 token。
# AUTH 只存 header 的【值】（`Basic <base64(instanceID:token)>`），header 的 key
# 由 otel/collector-config.yaml 指定；Grafana 原始片段裡的 `Authorization=` 前綴要拿掉。
# ⚠️ 「Basic」與 base64 之間的空格不可省略，少了它會是 401 而非明顯的格式錯誤。
# GRAFANA_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp
# GRAFANA_OTLP_AUTH=Basic <base64>

# 應用程式端的遙測開關。預設 false → 本機 pytest 與 uvicorn --reload 完全不受影響，
# 不需要任何額外依賴或設定；docker compose 才開啟（見 docker-compose.yml）。
# 只管「開不開」，不管「往哪送、怎麼取樣」——後者走 OTel 規格的標準 OTEL_* 變數，
# 由 SDK 自己讀，避免在 config.py 複製一份會漂移的設定表面。
# OTEL_ENABLED=false

# === Airflow 失敗通知（可選）===
# 四支【排程】DAG 失敗時會呼叫 orchestration/dags/_notify.py 的 callback。
# 不設下面這個變數 → 通道是 log：訊息寫進該 task 的 Airflow log，clone 下來就能跑，
# 但**沒有任何人會被主動通知**（見 _notify.py 檔頭 ①、ORCHESTRATION-TW.md §4）。
#
# 設了 → 改用 HTTP POST，payload 是 {"text": "<訊息>"}，即 Slack Incoming Webhook
# 的格式。Discord（欄位叫 content）或 ntfy（吃純文字 body）要改 _notify._deliver
# 的那一行 payload。
# ⚠️ 這個 URL 本身就是唯一的憑證，別提交進版控。
# NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
# 送出逾時（秒）。callback 跑在 task 行程裡，吊住的 POST 會佔住執行槽。
# NOTIFY_WEBHOOK_TIMEOUT_S=3

# === Docker Compose 專用（僅本機跑 docker compose 時用到）===
# 這三個值供 compose 建立 db 服務並組出 api/migrate 的 DB_URL（host=db）。
# 不設則吃預設 app / app / orders。本機 pytest 不受影響，仍用上方 DB_URL。
# POSTGRES_USER=app
# POSTGRES_PASSWORD=app
# POSTGRES_DB=orders

# db / redis 對外發布的埠。db 預設 5433 而非 5432：主機上若已有 postgres 佔著
# 5432，compose 的 db 會直接起不來（address already in use）。容器之間走
# compose 網路的 db:5432 / redis:6379，不經過這兩個映射——它們純粹給主機端除錯用。
# DB_PUBLISH_PORT=5433
# REDIS_PUBLISH_PORT=6379
