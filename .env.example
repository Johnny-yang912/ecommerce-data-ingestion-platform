# 環境變數範本 — 複製成 .env 後填入真值（.env 不進版控）
# 由 config.py 的 Settings 載入；未列在此的鍵會被忽略（extra="ignore"）。

# === 必填 ===
# PostgreSQL 連線字串；缺此值服務啟動時即報錯（fail-fast）
DB_URL=postgresql://user:password@localhost:5432/dbname

# 服務對服務認證：格式 key:client_id，逗號分隔多組（同 client 可多把 key 做輪替）
API_KEYS=your_key:upstream-order-api

# === 選填（以下為預設值，需要時才覆寫）===
# DB connection pool 與 statement timeout
# POOL_SIZE=5
# MAX_OVERFLOW=10
# POOL_TIMEOUT=30
# STATEMENT_TIMEOUT_MS=30000

# 背景 stuck-record 掃描間隔（秒）
# SCAN_INTERVAL_SECONDS=300

# 日誌格式：console（開發，人類可讀）| json（生產，結構化）
# LOG_FORMAT=console

# === Phase 4：分析管線（ODS → BigQuery）===
# BigQuery service-account 金鑰路徑（與 dbt 共用同一把）。
# 僅抽取腳本用得到；API server 不需要，留空亦可正常啟動。
# 正式環境（Airflow / Cloud Run）改由平台注入此環境變數，會優先於此值（見 bq.py 的 setdefault）。
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# BigQuery 目的地專案 ID（注意是 project ID，非顯示名稱；GCP 常自動補數字後綴）。
# 僅抽取腳本用得到；缺值時腳本啟動即報錯（fail-fast），API server 不受影響。
# BQ_PROJECT=your-gcp-project-id

# === Phase 5：Proposal B 重評估（讀 dbt 產出的 int_ 層）===
# dbt profile 的 target dataset。dev/prod 不同專案或不同 dataset 時才需覆寫。
# 僅 reevaluate_quality.py 用得到。
# BQ_DBT_DATASET=dbt_dev

# === Docker Compose 專用（僅本機跑 docker compose 時用到）===
# 這三個值供 compose 建立 db 服務並組出 api/migrate 的 DB_URL（host=db）。
# 不設則吃預設 app / app / orders。本機 pytest 不受影響，仍用上方 DB_URL。
# POSTGRES_USER=app
# POSTGRES_PASSWORD=app
# POSTGRES_DB=orders
